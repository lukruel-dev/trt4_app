# Conexão com o banco de dados (Supabase / Postgres)
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# NextAuth / Auth.js Secret (pode gerar executando: openssl rand -base64 32 ou npx auth secret)
AUTH_SECRET="gerar-chave-secreta-aleatoria-base64"

# Google OAuth 2.0 Credentials (obtidas no Google Cloud Console)
AUTH_GOOGLE_ID="seu-cliente-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="seu-client-secret-do-google"
