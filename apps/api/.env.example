# ==========================================
# Variáveis de Ambiente - Backend (NestJS)
# ==========================================

# String de conexão do Supabase (Pooler na porta 6543 para operações da aplicação)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# String de conexão direta do Supabase (Porta 5432 / Direct Session - usada pelo Prisma para Migrations/db push)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Porta do servidor (no Render é injetada automaticamente pela plataforma)
PORT=3001

# Lista de origens permitidas para CORS (separadas por vírgula)
CORS_ORIGIN="http://localhost:3000,https://seu-frontend.onrender.com"
